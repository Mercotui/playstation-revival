diff --git a/packages/emulation/duckstation/package.mk b/packages/emulation/duckstation/package.mk
new file mode 100644
index 0000000000..bd5a995ec0
--- /dev/null
+++ b/packages/emulation/duckstation/package.mk
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2021-2026 Shanti Gilbert (https://github.com/shantigilbert)
+# Copyright (C) 2026 Menno van der Graaf (https://github.com/mercotui)
+
+PKG_NAME="duckstation"
+PKG_VERSION="fd3507c16d098fb32806c281caaefb205946da8a"
+PKG_SHA256="e8d12c689f6bdff539485e22f21399613b9f6830652591c8607b3a2e59053c4f"
+PKG_ARCH="aarch64"
+PKG_LICENSE="GPLv3"
+PKG_SITE="https://github.com/stenzek/duckstation"
+PKG_URL="https://github.com/stenzek/duckstation/archive/${PKG_VERSION}.tar.gz"
+PKG_DEPENDS_TARGET="toolchain SDL2 nasm:host ${OPENGLES} libevdev libdrm"
+PKG_SHORTDESC="Fast PlayStation 1 emulator for x86-64/AArch32/AArch64 "
+PKG_TOOLCHAIN="cmake"
+
+pre_configure_target() {
+  PKG_CMAKE_OPTS_TARGET+=" -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+                           -DANDROID=OFF \
+                           -DENABLE_DISCORD_PRESENCE=OFF \
+                           -DUSE_X11=OFF \
+                           -DUSE_DRMKMS=ON \
+                           -DUSE_FBDEV=OFF \
+                           -DUSE_MALI=OFF \
+                           -DBUILD_QT_FRONTEND=OFF \
+                           -DBUILD_NOGUI_FRONTEND=ON \
+                           -DCMAKE_BUILD_TYPE=Release \
+                           -DBUILD_SHARED_LIBS=OFF \
+                           -DUSE_SDL2=ON \
+                           -DENABLE_CHEEVOS=ON \
+                           -DHAVE_EGL=ON \
+                           -DCMAKE_BUILD_TYPE=Debug"
+
+  export CXXFLAGS+=" -include cstdarg -include cstdint -include cstring -include cstdio -include limits"
+
+  sed -i '/eglGetConfigAttrib(m_display, config, EGL_NATIVE_VISUAL_ID, &visual_id);/r '${PKG_DIR}'/debug-egl.inc' \
+    ${PKG_BUILD}/src/common/gl/context_egl_gbm.cpp
+}
+
+makeinstall_target() {
+  mkdir -p ${INSTALL}/usr/bin \
+           ${INSTALL}/usr/lib/duckstation \
+           ${INSTALL}/usr/share/duckstation
+
+  # DuckStation resolves resources/, database/ and shaders/ relative to the
+  # real path of its executable (/proc/self/exe), so keep them together.
+  cp -rf ${PKG_BUILD}/.${TARGET_NAME}/bin/* ${INSTALL}/usr/lib/duckstation/
+  cp -rf ${PKG_DIR}/config/* ${INSTALL}/usr/lib/duckstation/
+  rm -rf ${INSTALL}/usr/lib/duckstation/common-tests
+
+  # A settings.ini next to the executable makes DuckStation switch to
+  # "portable mode" (user dir = read-only program dir), so keep the default
+  # config elsewhere. The launcher seeds /storage/.config/duckstation from it.
+  if [ -f ${INSTALL}/usr/lib/duckstation/settings.ini ]; then
+    mv ${INSTALL}/usr/lib/duckstation/settings.ini ${INSTALL}/usr/share/duckstation/settings.ini
+  fi
+  rm -f ${INSTALL}/usr/lib/duckstation/portable.txt
+
+  # BIOS lookup falls back to <program dir>/bios
+  rm -rf ${INSTALL}/usr/lib/duckstation/bios
+  ln -sf /storage/roms/bios ${INSTALL}/usr/lib/duckstation/bios
+
+  ln -sf ../lib/duckstation/duckstation-nogui ${INSTALL}/usr/bin/duckstation-nogui
+  install -m 0755 ${PKG_DIR}/scripts/duckstation.sh ${INSTALL}/usr/bin/duckstation.sh
+}
