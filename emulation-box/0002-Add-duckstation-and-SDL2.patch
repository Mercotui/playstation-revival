diff --git a/packages/emulation/duckstation/scripts/duckstation.sh b/packages/emulation/duckstation/scripts/duckstation.sh
new file mode 100755
index 0000000000..761464a61b
--- /dev/null
+++ b/packages/emulation/duckstation/scripts/duckstation.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2021-present Shanti Gilbert (https://github.com/shantigilbert)
+# Copyright (C) 2026 Menno van der Graaf (https://github.com/mercotui)
+
+PROG_DIR=/usr/lib/duckstation
+DEFAULT_CONFIG=/usr/share/duckstation/settings.ini
+CONFIG_DIR=/storage/.config/duckstation
+LOCAL_CONFIG=/storage/.local/share
+
+mkdir -p "${CONFIG_DIR}" "${LOCAL_CONFIG}" /storage/roms/bios /storage/roms/psx/textures
+
+# Seed writable files on first run
+[ -e "${CONFIG_DIR}/settings.ini" ] || cp -f "${DEFAULT_CONFIG}" "${CONFIG_DIR}/settings.ini"
+for f in inputprofiles shaders; do
+  [ -e "${CONFIG_DIR}/${f}" ] || cp -rf "${PROG_DIR}/${f}" "${CONFIG_DIR}/"
+done
+
+# Texture replacement
+[ -e "${CONFIG_DIR}/textures" ] || ln -s /storage/roms/psx/textures "${CONFIG_DIR}/textures"
+
+# DuckStation's default user dir is ~/.local/share/duckstation; point it at CONFIG_DIR
+if [ ! -L "${LOCAL_CONFIG}/duckstation" ]; then
+  rmdir "${LOCAL_CONFIG}/duckstation" 2>/dev/null   # only removes an empty dir
+  ln -s "${CONFIG_DIR}" "${LOCAL_CONFIG}/duckstation"
+fi
+
+if [ -z "${1}" ]; then
+  exec duckstation-nogui -fullscreen -settings "${CONFIG_DIR}/settings.ini"
+else
+  exec duckstation-nogui -fullscreen -settings "${CONFIG_DIR}/settings.ini" -- "${1}"
+fi
